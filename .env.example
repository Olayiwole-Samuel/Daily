# Copy this file to .env.local and fill it in. .env.local is never committed.

# Google OAuth client ID (Web application) from console.cloud.google.com. Public, used in the browser.
VITE_GOOGLE_CLIENT_ID=

# Anthropic API key for the AI Coach (console.anthropic.com). SERVER ONLY: it has no
# VITE_ prefix, so Vite never puts it in the browser bundle. Leave empty to get a sample plan.
ANTHROPIC_API_KEY=
